{
  "name": "repospector",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/eval",
    "packages/mcp",
    "packages/extension"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/extension packages/eval packages/mcp && npm run build -w @repospector/extension",
    "typecheck": "tsc -b packages/core packages/extension packages/eval packages/mcp --pretty",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "audit:prod": "npm audit --omit=dev --audit-level=low",
    "audit:all": "npm audit"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
