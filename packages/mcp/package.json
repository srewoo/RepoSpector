{
  "name": "repospector-mcp",
  "version": "0.3.0",
  "description": "RepoSpector as an MCP server — repository graph and retrieval context for Claude and Codex. No API key.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "repospector-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/",
    "build": "node build.js",
    "prepublishOnly": "node build.js && node --test test/",
    "start": "node src/index.js",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "release": "npm publish",
    "release:dry": "npm publish --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@xenova/transformers": "^2.17.2",
    "fake-indexeddb": "^6.0.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.25.10"
  },
  "devDependencies": {
    "esbuild": "0.27.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srewoo/RepoSpector.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/srewoo/RepoSpector/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/srewoo/RepoSpector/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-review",
    "code-graph",
    "tree-sitter",
    "rag",
    "claude",
    "static-analysis"
  ]
}
