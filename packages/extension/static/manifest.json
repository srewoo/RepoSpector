{
  "manifest_version": 3,
  "name": "RepoSpector",
  "version": "0.1.0",
  "description": "Open-source AI code review for GitHub and GitLab with your own model key. Code goes only to the git host and the model provider you choose.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "offscreen",
    "scripting"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "RepoSpector"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
